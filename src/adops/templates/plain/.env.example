# Copy this file to .env and replace the passwords. Never commit .env.
WAREHOUSE_PASSWORD=change-me
DAGSTER_PG_HOST=localhost
DAGSTER_PG_PORT=15434
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=change-me

# The Server (`docker compose --profile server up`) runs Pipelines on their Schedules in this Environment.
# Add a stage (or prod) Environment to adops.yaml before starting it.
ADOPS_ENVIRONMENT=stage
# The Dagster page has no login: reach it through an SSH tunnel; bind wider only on a trusted network.
DAGSTER_WEBSERVER_HOST=127.0.0.1
DAGSTER_WEBSERVER_PORT=3000
# Failed Server runs are posted to this URL; leave it empty to turn alerts off.
ALERT_WEBHOOK_URL=
